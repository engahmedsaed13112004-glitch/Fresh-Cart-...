{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*", "./Components/*"],
      "@/_components/*": ["./_components/*", "./src/_components/*"]
    },
    "jsx": "react-jsx",
    "allowJs": true
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist"]
}